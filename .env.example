# Copy to .env for LOCAL development only. Never commit .env. All values below are placeholders.
# In production, inject these from your platform's secret manager, not from a file in the repo.

TIDEWATCH_ENV=dev                 # dev | prod
TIDEWATCH_MODE=demo               # demo = synthetic data (default). live = poll the watched apps (M5)

# JSON lists. Exact origins / hostnames only - wildcards are rejected at startup.
TIDEWATCH_ALLOWED_ORIGINS=["http://localhost:5173"]
TIDEWATCH_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Live mode only: JSON list of API keys (>= 32 random chars in prod). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# TIDEWATCH_API_KEYS=["<generate-me>"]

# Live mode (docs/ARCHITECTURE.md s.6). Each app serves GET /tidewatch/metrics (addons/).
# Full metrics URL per app; ids [a-z0-9]{1,15}; https only when TIDEWATCH_ENV=prod.
# TIDEWATCH_LIVE_SOURCES=[{"id":"app1","name":"App One","url":"https://app1.example.com/tidewatch/metrics"}]
# One token per source id: the same value as that app's TIDEWATCH_METRICS_TOKEN. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# TIDEWATCH_SOURCE_TOKENS={"app1":"<generate-me>"}
# Serve live data without API keys (public, aggregates only - owner risk acceptance, SECURITY.md s.8).
# TIDEWATCH_LIVE_PUBLIC=false
# TIDEWATCH_LIVE_POLL_SECONDS=10    # 5..120; polling happens only while someone is watching
# TIDEWATCH_LIVE_ALLOW_PRIVATE=false  # dev only: allow polling apps on localhost/private addresses

# Used by deploy/docker-compose.yml
TIDEWATCH_DOMAIN=localhost
