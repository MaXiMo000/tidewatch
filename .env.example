# Copy to .env for LOCAL development only. Never commit .env. All values below are placeholders.
# In production, inject these from your platform's secret manager, not from a file in the repo.

TIDEWATCH_ENV=dev                 # dev | prod
TIDEWATCH_MODE=demo               # demo = synthetic data (default). live = real adapters (Milestone M5)

# JSON lists. Exact origins / hostnames only - wildcards are rejected at startup.
TIDEWATCH_ALLOWED_ORIGINS=["http://localhost:5173"]
TIDEWATCH_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Live mode only: JSON list of API keys (>= 32 random chars in prod). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# TIDEWATCH_API_KEYS=["<generate-me>"]

# Used by deploy/docker-compose.yml
TIDEWATCH_DOMAIN=localhost
