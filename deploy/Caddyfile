# Single public origin: static frontend + reverse proxy to the private backend.
# One origin => no CORS, no cross-site tokens. TLS is automatic (Let's Encrypt; local CA for localhost).
{
	# Clients that send no SNI (Java/ZAP never sends it for a dotless host like "localhost") get
	# this site's certificate instead of a failed handshake. Only one site is served anyway.
	default_sni {$TIDEWATCH_DOMAIN:localhost}
}

{$TIDEWATCH_DOMAIN:localhost} {
	encode zstd gzip

	# Headers for every response. The CSP is NOT set here: the API sets its own stricter one
	# (default-src 'none', backend/app/security.py) and a site-wide header would overwrite it.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-Via
	}

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /ws/* {
		reverse_proxy backend:8000
	}
	handle {
		# Strict CSP: no inline script/style, no third-party origins. WebGL needs no 'unsafe-eval'.
		# style-src 'self' is fine for three (it uses CSSOM, not style attributes in markup).
		# Trusted Types enforced with no policy at all: nothing may pass a string to a DOM XSS sink.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{$TIDEWATCH_DOMAIN:localhost}; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
